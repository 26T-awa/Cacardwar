# 选择槽位（0~9）
$tellraw @a ["", {text:"选择槽位 (0~9)，卡牌 $(card) ",color:"aqua"}]
# 注意：$card_name 你可以自定义卡牌名称，此处简化，直接显示数字
# 但为了美观，可以定义一个storage存储卡牌名，但这里不展开
$tellraw @a [{text:"0 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:0}"}},{text:"1 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:1}"}},{text:"2 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:2}"}},{text:"3 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:3}"}},{text:"4 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:4}"}},{text:"5 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:5}"}},{text:"6 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:6}"}},{text:"7 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:7}"}},{text:"8 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:8}"}},{text:"9 ",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_type {card:$(card), slot:9}"}}]
tellraw @a [{text:"[返回]",color:"gray",click_event:{action:"run_command",command:"function cacardwar:agent/training/input/place_card"}}]